<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chalkboard | ATA Pending Approvals</title>
    <link rel="icon" type="image/x-icon" href="/common/img/chalkboardLogo.ico">
    <link rel="stylesheet" href="/ATA/css/pending-approvals.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.5/dist/signature_pad.umd.min.js"></script>
    
</head>
<body data-role="<%= typeof role !== 'undefined' ? role : 'Admin' %>"
      data-employment="<%= (typeof user !== 'undefined' && user.employmentType) ? user.employmentType : 'Full-Time' %>"
      data-practicum="<%= (typeof user !== 'undefined' && user.isPracticumCoordinator) ? 'true' : 'false' %>"
      data-user-sig="<%= typeof user !== 'undefined' && user.signatureImage ? user.signatureImage : '' %>">
      
    <% 
        if (typeof role !== 'undefined') {
            if (['Admin', 'VPAA', 'HR', 'HRMO'].includes(role)) { %>
                <%- include('../MainPages/admin/partials/adminSideMenuBar') %>
            <% } else if (role === 'Dean') { %>
                <%- include('../MainPages/dean/partials/deanMenuBar') %>
            <% } else if (role === 'Program-Chair') { %>
                <%- include('../MainPages/progChair/partials/progChairMenuBar') %>
            <% } else { %>
                <%- include('../partials/sideMenuBar') %>
            <% } 
        } else { %>
            <%- include('../partials/sideMenuBar') %>
        <% }
    %>
    
    <main class="main-content" style="margin-left: 260px; width: calc(100vw - 260px);">

        <div class="bb-page-header">
            <div class="user-profile-row">
                <div class="user-avatar">
                    <% if (typeof isHistory !== 'undefined' && isHistory) { %>
                        <i class="fas fa-history" style="color: #4a9eff;"></i>
                    <% } else { %>
                        <i class="fas fa-inbox" style="color: #ffc107;"></i>
                    <% } %>
                </div>
                <div class="user-name">
                    <% if (typeof isHistory !== 'undefined' && isHistory) { %>
                        Processed & Approved Forms
                    <% } else { %>
                        Forms to Approve
                    <% } %>
                </div>
            </div>

            <div class="search-wrapper">
                <i class="fas fa-search"></i>
                <input type="text" id="facultySearchInput" class="search-input" placeholder="Search by Faculty Name...">
            </div>

            <a href="<%= (typeof role !== 'undefined' && ['Admin', 'VPAA', 'HR', 'HRMO'].includes(role)) ? '/admin/ata' : '/ata/dashboard/window' %>" class="btn-outline">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>

        <div class="bb-scroll-area">
            
            <div class="bb-accent-line"></div>

            <div class="bb-tabs-wrapper">
                <div>
                    <div class="bb-tab">
                        <% if (typeof isHistory !== 'undefined' && isHistory) { %>
                            Approval History
                        <% } else { %>
                            Pending Inbox
                        <% } %>
                        <span style="color: #888; font-weight: normal; font-size: 13px; margin-left: 10px;">
                            (<%= role %> - <%= college %>)
                        </span>
                    </div>
                </div>

                <% if (typeof isHistory === 'undefined' || !isHistory) { %>
                    <div class="signature-actions-bar">
                        <span style="font-size: 13px; font-weight: 600; color: #666; margin-right: 5px;">
                            <i class="fas fa-pen-nib"></i> E-Signature:
                        </span>

                        <button id="openSignatureModal" class="btn-action" style="background: <%= typeof user !== 'undefined' && user.signatureImage ? '#17a2b8' : '#28a745' %>; color: white;">
                            <i class="fas fa-signature"></i> <%= typeof user !== 'undefined' && user.signatureImage ? 'Change' : 'Setup' %>
                        </button>

                        <% if (typeof user !== 'undefined' && user.signatureImage) { %>
                            <button type="button" id="mainPreviewSigBtn" class="btn-action" style="background: #6c757d; color: white;">
                                <i class="fas fa-file-pdf"></i> Preview
                            </button>
                            
                            <button type="button" id="mainDeleteSigBtn" class="btn-action" style="background: #dc3545; color: white;">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <div class="bb-table-container">
                <table class="bb-table" id="approvalsTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;"></th>
                            <th style="width: 25%;">Faculty Name <i class="fas fa-sort"></i></th>
                            <th style="width: 25%;">Approval Track <i class="fas fa-sort"></i></th>
                            <th style="width: 15%;">Term <i class="fas fa-sort"></i></th>
                            <th style="width: 15%;">Status <i class="fas fa-sort"></i></th>
                            <th style="width: 10%; text-align: center;">Action <i class="fas fa-sort"></i></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (forms.length === 0) { %>
                            <tr class="no-data-row">
                                <td colspan="6" style="padding: 60px; text-align: center; color: #888; font-size: 16px;">
                                    <% if (typeof isHistory !== 'undefined' && isHistory) { %>
                                        <i class="fas fa-folder-open" style="font-size: 40px; margin-bottom: 15px; display: block; color: #ccc;"></i>
                                        Your approved history is currently empty.
                                    <% } else { %>
                                        <i class="fas fa-check-circle" style="font-size: 40px; margin-bottom: 15px; display: block; color: #28a745;"></i>
                                        You're all caught up! No pending forms require your attention.
                                    <% } %>
                                </td>
                            </tr>
                        <% } else { %>
                            <% forms.forEach(form => { %>
                                <tr class="data-row">
                                    <td class="row-icon-cell">
                                        <div class="row-icon-wrapper">
                                            <% if (form.status !== 'FINALIZED') { %>
                                                <span class="row-dot"></span>
                                            <% } else { %>
                                                <span class="row-dot" style="background-color: transparent;"></span>
                                            <% } %>
                                            <i class="fas fa-file-signature row-icon" style="color: #444;"></i>
                                        </div>
                                    </td>

                                    <td class="searchable-name">
                                        <div style="font-weight: 700; font-size: 15px;"><%= form.facultyName %></div>
                                        <div style="font-size: 12px; color: #777;"><%= form.college %></div>
                                    </td>

                                    <td>
                                        <% if (form.approvalHistory && form.approvalHistory.length > 0) { %>
                                            <% const revHistory = [...form.approvalHistory].reverse(); %>
                                            <ul class="track-list">
                                                <% revHistory.forEach((log, index) => { %>
                                                    <li class="track-item <%= index > 0 ? 'hidden-track' : '' %>" style="<%= index > 0 ? 'display: none;' : '' %>">
                                                        <% if (log.approvalStatus === 'RETURNED' || log.approvalStatus === 'REJECTED') { %>
                                                            <i class="fas fa-times-circle" style="color: #dc3545; margin-top: 3px;"></i>
                                                        <% } else { %>
                                                            <i class="fas fa-check-circle" style="color: #28a745; margin-top: 3px;"></i>
                                                        <% } %>
                                                        <div>
                                                            <strong style="color: #222;"><%= log.approverName || log.approverRole %></strong> 
                                                            (<%= log.approvalStatus %>) <br>
                                                            <span style="font-size: 11px; color: #888;"><%= new Date(log.date).toLocaleDateString() %></span>
                                                            
                                                            <% if (log.approvalStatus === 'RETURNED' && log.remarks) { %>
                                                                <div class="track-reason">
                                                                    <strong>Reason:</strong> <%= log.remarks %>
                                                                </div>
                                                            <% } %>
                                                        </div>
                                                    </li>
                                                <% }) %>
                                            </ul>
                                            
                                            <% if (revHistory.length > 1) { %>
                                                <button type="button" onclick="toggleHistory(this)" style="background: transparent; border: none; color: #a0a0a0; font-size: 11px; font-weight: bold; cursor: pointer; padding: 5px 0 0 0; display: inline-flex; align-items: center; gap: 5px;">
                                                    <i class="fas fa-chevron-down"></i> <span class="toggle-txt">View <%= revHistory.length - 1 %> older actions</span>
                                                </button>
                                            <% } %>

                                        <% } else { %>
                                            <span style="color: #888; font-style: italic;">No actions yet.</span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <div style="font-weight: 600;"><%= form.term %></div>
                                        <div style="font-size: 12px; color: #777;"><%= form.academicYear %></div>
                                    </td>

                                    <td>
                                        <% 
                                            let displayStatus = form.status.replace('PENDING_', 'Awaiting ');
                                            if (displayStatus === 'Awaiting PRACTICUM') displayStatus = 'Awaiting Practicum';
                                            if (displayStatus === 'Awaiting CHAIR') displayStatus = 'Awaiting Chair';
                                            if (displayStatus === 'Awaiting DEAN') displayStatus = 'Awaiting Dean';
                                        %>
                                        <% if (form.status === 'FINALIZED') { %>
                                            <span class="badge-green"><i class="fas fa-check-double"></i> Finalized</span>
                                        <% } else { %>
                                            <span class="badge-yellow"><i class="fas fa-clock"></i> <%= displayStatus %></span>
                                        <% } %>
                                    </td>

                                    <td style="text-align: center;">
                                        <div style="display: flex; flex-direction: column; align-items: center;">
                                            <% if (typeof isHistory !== 'undefined' && isHistory) { %>
                                                <a href="/ata/view-submission/<%= form._id %>" class="btn-dark">
                                                    View Form
                                                </a>
                                            <% } else { %>
                                                <a href="/ata/view/<%= form._id %>" class="btn-dark">
                                                    Review
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </div> </main>

    <div class="modal-overlay" id="sigModalOverlay">
        <div class="signature-modal" style="max-height: 95vh; overflow-y: auto;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #b30000; padding-bottom: 8px; margin-bottom: 8px;">
                <h2 style="margin: 0; font-size: 1.5rem;">
                    <i class="fas fa-lock"></i> VIP Signature Vault
                </h2>
                <button type="button" id="closeVipSigBtn" style="background: transparent; border: none; font-size: 1.5rem; color: #888; cursor: pointer; padding: 0; transition: color 0.2s;" onmouseover="this.style.color='#dc3545'" onmouseout="this.style.color='#888'">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <p style="font-size: 0.85rem; color: #ccc; margin-top: 0; margin-bottom: 12px; line-height: 1.3;">
                Draw your signature below. This will be securely saved to your profile and automatically stamped on ATA forms when you click "Approve".
            </p>

            <% if (typeof user !== 'undefined' && user.signatureImage) { %>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <div style="font-size: 0.85rem; color: #aaa; font-weight: 600;">Current Saved Signature:</div>
                    <button type="button" id="deleteVipSigBtn" style="background: transparent; border: 1px solid #dc3545; color: #dc3545; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; transition: all 0.2s;" onmouseover="this.style.background='#dc3545'; this.style.color='white';" onmouseout="this.style.background='transparent'; this.style.color='#dc3545';">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
                <div class="signature-preview-box" style="margin-bottom: 15px; display: flex; justify-content: center; align-items: center; background: #ffffff; border: 1px solid #ccc; border-radius: 4px; width: 400px; height: 250px; margin-left: auto; margin-right: auto; overflow: hidden;">
                    <img src="<%= user.signatureImage %>" style="width: 100%; height: 100%; object-fit: contain;">
                </div>
            <% } %>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; margin-bottom: 10px;">
                <div style="font-size: 0.85rem; color: #aaa; font-weight: 600;">Draw New Signature:</div>
                <div>
                    <input type="file" id="uploadVipSignatureInput" accept="image/png, image/jpeg, image/jpg" style="display: none;">
                    <label for="uploadVipSignatureInput" style="background: #374151; border: 1px solid #4b5563; color: #e5e7eb; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 5px; margin: 0; transition: all 0.2s;" onmouseover="this.style.background='#4b5563'" onmouseout="this.style.background='#374151'">
                        <i class="fas fa-upload"></i> Upload Image
                    </label>
                </div>
            </div>

            <div style="position: relative; width: 400px; height: 150px; background: #ffffff; border: 1px solid #ccc; border-radius: 4px; overflow: hidden; margin: 0 auto; display: block; flex-shrink: 0;">
                <span id="drawPlaceholder" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #e2e8f0; font-size: 32px; font-weight: 900; font-family: sans-serif; letter-spacing: 4px; pointer-events: none; user-select: none; z-index: 5;">DRAW</span>
                
                <canvas id="vipSignatureCanvas" width="400" height="150" style="display: block; width: 400px; height: 150px; background: transparent; cursor: crosshair; position: relative; z-index: 10;"></canvas>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; border-top: 1px solid #444; padding-top: 12px;">
                <button type="button" id="clearVipSigBtn" style="background: transparent; border: 1px solid #6c757d; color: #adb5bd; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s;" onmouseover="this.style.background='#6c757d'; this.style.color='white';" onmouseout="this.style.background='transparent'; this.style.color='#adb5bd';">
                    <i class="fas fa-eraser"></i> Clear Canvas
                </button>

                <div style="display: flex; gap: 10px;">
                    <button type="button" id="previewVipSigBtn" style="background: transparent; border: 1px solid #17a2b8; color: #17a2b8; padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s;" onmouseover="this.style.background='#17a2b8'; this.style.color='white';" onmouseout="this.style.background='transparent'; this.style.color='#17a2b8';">
                        <i class="fas fa-file-pdf"></i> Preview
                    </button>
                    
                    <button type="button" id="saveVipSigBtn" style="background: #28a745; border: 1px solid #28a745; color: white; padding: 8px 18px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: all 0.2s;" onmouseover="this.style.background='#218838'" onmouseout="this.style.background='#28a745'">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="cropperModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 99999; justify-content: center; align-items: center;">
        <div style="background: white; padding: 20px; border-radius: 8px; max-width: 90%; width: 500px; text-align: center;">
            <h3 style="margin-top: 0;">Crop Your Signature</h3>
            <p style="font-size: 12px; color: #666;">Drag the corners to fit exactly around your ink.</p>
            <div style="width: 100%; max-height: 400px; overflow: hidden; margin-bottom: 20px;">
                <img id="imageToCrop" src="" style="max-width: 100%;">
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 25px;">
                <button type="button" id="cancelCropBtn" style="background: #f1f3f5; color: #495057; border: 1px solid #ced4da; padding: 10px 20px; font-weight: bold; border-radius: 6px; cursor: pointer;">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <button type="button" id="confirmCropBtn" style="background: linear-gradient(135deg, #002455 0%, #004080 100%); color: white; border: none; padding: 10px 24px; font-weight: bold; border-radius: 6px; box-shadow: 0 4px 10px rgba(0, 36, 85, 0.25); font-size: 15px; cursor: pointer;">
                    <i class="fas fa-check-circle"></i> Confirm
                </button>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>  
    <script src="/ATA/js/ata_client.js"></script>
    <script src="/ATA/js/pending-approvals.js"></script>
</body>
</html>